# Copy to `.env` and fill from the Firebase console:
# Project settings → General → Your apps → Web app → SDK setup and configuration.
# The project is `volleyball-lab` — the same one app/google-services.json points
# at, which is what makes the portal and the Android app talk to each other.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=volleyball-lab.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=volleyball-lab
VITE_FIREBASE_STORAGE_BUCKET=volleyball-lab.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
