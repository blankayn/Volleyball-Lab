<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="sessions/" />
        <exclude domain="file" path="video_reviews/" />
        <exclude domain="file" path="captures/" />
        <exclude domain="file" path="profile_photos/" />
        <exclude domain="sharedpref" path="auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="video_reviews/" />
        <exclude domain="file" path="profile_photos/" />
        <exclude domain="file" path="captures/" />
        <exclude domain="sharedpref" path="auth.xml" />
    </device-transfer>
</data-extraction-rules>
