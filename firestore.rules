rules_version = '2';

// Volleyball Lab coach cloud — enforcement for docs/coach-cloud-contract.md.
//
// Shape of the trust model, in one paragraph: an account owns its own rows; a
// coach additionally owns their team rows (roster, assignments, submissions,
// notes for rostered players); a player additionally owns their requests into a
// roster and their submissions out of it; and a coach reads a session only when
// the athlete put them in `sharedWith` by submitting. Everything else is
// denied. There is no admin role in v1 — see the contract on self-promotion.
// Schema: docs/coach-cloud-contract.md and Android CloudSchema.kt.
// users: role/displayName/email, createdAt/updatedAt (epoch ms).
// profiles/{uid}: owner-private name(max81), firstName/lastName(max40), nullable
// address {country:{id ISO2,name max160}, nullable area/city/barangay:{id max32,name max160}}.
// Profile fields are optional for independent merge patches; updatedAt is required server timestamp.
// coaches: bounded public names plus owner-private licence/preferences.
// coachDirectory: public projection, nullable specialisation/experience, rosterSize.
// roster: immutable playerUid, bounded name/position, Pending/Active/Ended, dates.
// assignments/notes/submissions: immutable owner/recipient IDs and bounded content.
// sessions: immutable owner/id/createdAt, bounded score arrays and optional stages.
// Client-computed scores remain estimates, never proof of payment or accuracy.
// Billing documents are server-only writes, with owner-only order/entitlement reads.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && notDeleting(request.auth.uid);
    }
    function notDeleting(uid) {
      return !exists(/databases/$(database)/documents/accountDeletions/$(uid));
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function boundedString(value, maximum) {
      return value is string && value.size() <= maximum;
    }
    function validUid(value) {
      return boundedString(value, 128) && value.size() > 0;
    }
    function validDate(value) {
      return value is number && value >= 0 && value <= 4102444800000;
    }
    function nullableDate(value) {
      return value == null || validDate(value);
    }
    function validSkill(value) {
      return value in ['Serving', 'Receiving', 'Setting', 'Spiking', 'Blocking'];
    }
    function validScore(value) {
      return value == null || (value is number && value >= 0 && value <= 100);
    }
    function unchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    function isValidUser(data) {
      return data.keys().hasOnly(['role', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.role in ['PLAYER', 'COACH', 'Player', 'Coach']
        && boundedString(data.displayName, 60) && boundedString(data.email, 254)
        && validDate(data.createdAt) && validDate(data.updatedAt);
    }
    // Written with few expressions: one request may evaluate 1000, and a full
    // profile with an address and a training setup comes close. matches() refuses
    // anything that is not a string.
    function validAddressOption(data) {
      return data is map && data.size() == 2 && data.id.matches('.{1,32}') && data.name.matches('.{1,160}');
    }
    function nullableAddressOption(data) {
      return data == null || validAddressOption(data);
    }
    function validProfileAddress(data) {
      return data == null || (data is map
        && data.keys().hasAll(['country', 'area', 'city', 'barangay'])
        && data.keys().hasOnly(['country', 'area', 'city', 'barangay'])
        && validAddressOption(data.country) && data.country.id.matches('[A-Z]{2}')
        && nullableAddressOption(data.area) && nullableAddressOption(data.city) && nullableAddressOption(data.barangay)
        && (data.area != null || (data.city == null && data.barangay == null))
        && (data.city != null || data.barangay == null)
        && (data.barangay == null || data.country.id == 'PH'));
    }
    function validSetupExperience(value) {
      return value == null || value in ['New', 'Developing', 'Experienced'];
    }
    function validSelfRatings(data) {
      return data is map && data.keys().hasOnly(['Serving', 'Receiving', 'Setting', 'Spiking', 'Blocking'])
        && data.values().hasOnly(['Struggling', 'Okay', 'Confident']);
    }
    function validSetupAssessment(data) {
      return data is map && data.keys().hasOnly(['ratings', 'experience', 'completedAtEpochMs', 'answers', 'focus'])
        && validSelfRatings(data.ratings) && validSetupExperience(data.experience)
        && (!('answers' in data) || validSkillCheck(data.answers))
        && (!('focus' in data) || validFocus(data.focus))
        && validDate(data.completedAtEpochMs);
    }
    // The four statements asked about each of the five skills.
    function validSkillCheck(data) {
      return data is map && data.size() <= 20
        && data.keys().hasOnly(['serving_ready', 'serving_movement', 'serving_control', 'serving_moving',
          'receiving_ready', 'receiving_movement', 'receiving_control', 'receiving_moving',
          'setting_ready', 'setting_movement', 'setting_control', 'setting_moving',
          'spiking_ready', 'spiking_movement', 'spiking_control', 'spiking_moving',
          'blocking_ready', 'blocking_movement', 'blocking_control', 'blocking_moving'])
        && data.values().hasOnly(['Yes', 'Sometimes', 'NotYet', 'NotTried']);
    }
    function validFocus(data) {
      return data is list && data.size() <= 5
        && data.hasOnly(['Serving', 'Receiving', 'Setting', 'Spiking', 'Blocking']);
    }
    function starterMatches(skill, drill) {
      return (skill == 'Serving' && drill == 'serve-standing-float')
        || (skill == 'Receiving' && drill == 'receive-wall-platform')
        || (skill == 'Setting' && drill == 'set-wall-reps')
        || (skill == 'Spiking' && drill == 'spike-standing-swing')
        || (skill == 'Blocking' && drill == 'block-ready-jumps');
    }
    function validStarterPlan(data) {
      return data == null || (data is map
        && data.keys().hasOnly(['focusSkill', 'weeklySessionGoal', 'goalText', 'experience', 'concern',
          'summary', 'source', 'starterDrillId', 'completedAtEpochMs', 'reason', 'questionId', 'optionId'])
        && validSkill(data.focusSkill) && data.weeklySessionGoal is int
        && data.weeklySessionGoal >= 1 && data.weeklySessionGoal <= 14
        && boundedString(data.goalText, 160) && boundedString(data.concern, 160)
        && boundedString(data.summary, 320) && boundedString(data.reason, 160)
        && boundedString(data.questionId, 64) && boundedString(data.optionId, 64)
        && validSetupExperience(data.experience) && data.source in ['groq', 'local']
        && starterMatches(data.focusSkill, data.starterDrillId) && validDate(data.completedAtEpochMs));
    }
    function validTrainingSetup(data) {
      return data == null || (data is map && data.keys().hasOnly(['version', 'hasOnboarded', 'assessment', 'plan'])
        && data.version == 1 && data.hasOnboarded == true
        && validSetupAssessment(data.assessment) && validStarterPlan(data.plan));
    }
    function isValidPrivateProfile(data) {
      return data.keys().hasAll(['updatedAt'])
        && data.keys().hasOnly(['name', 'firstName', 'middleName', 'lastName', 'address', 'updatedAt', 'position',
          'dominantHand', 'goalSkill', 'weeklySessionGoal', 'goalText', 'trainingSetup'])
        && (!('name' in data) || boundedString(data.name, 81))
        && (!('firstName' in data) || boundedString(data.firstName, 40))
        && (!('lastName' in data) || boundedString(data.lastName, 40))
        && (!('middleName' in data) || boundedString(data.middleName, 40))
        && (!('address' in data) || validProfileAddress(data.address))
        && (!('position' in data) || data.position == null || data.position in ['Setter', 'OutsideHitter', 'MiddleBlocker', 'Opposite', 'Libero'])
        && (!('dominantHand' in data) || data.dominantHand == null || data.dominantHand in ['Left', 'Right'])
        && (!('goalSkill' in data) || data.goalSkill == null || validSkill(data.goalSkill))
        && (!('weeklySessionGoal' in data) || (data.weeklySessionGoal is int && data.weeklySessionGoal >= 1 && data.weeklySessionGoal <= 14))
        && (!('goalText' in data) || boundedString(data.goalText, 160))
        && (!('trainingSetup' in data) || validTrainingSetup(data.trainingSetup))
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }
    function validSpecialisation(value) {
      return value == null || value == 'AllAround' || validSkill(value);
    }
    function validCoachingRole(data) {
      return !('coachingRole' in data) || data.coachingRole in [null, 'HeadCoach', 'AssistantCoach', 'Trainer', 'PETeacher'];
    }
    function validExperience(value) {
      return value == null || (value is number && value >= 0 && value <= 70);
    }
    function isValidCoach(data) {
      // Specialisation is written only by older app versions.
      return data.keys().hasOnly(['name', 'firstName', 'middleName', 'lastName', 'teamName', 'organisation',
          'specialisation', 'coachingRole', 'yearsExperience', 'licenceNumber', 'notifySubmissions', 'notifyWeeklyDigest', 'notifySafetyAlerts', 'updatedAt'])
        && boundedString(data.name, 60) && boundedString(data.teamName, 48)
        && boundedString(data.organisation, 48) && boundedString(data.licenceNumber, 40)
        && (!('firstName' in data) || boundedString(data.firstName, 40))
        && (!('middleName' in data) || boundedString(data.middleName, 40))
        && (!('lastName' in data) || boundedString(data.lastName, 40))
        && (!('specialisation' in data) || validSpecialisation(data.specialisation)) && validCoachingRole(data) && validExperience(data.yearsExperience)
        && data.notifySubmissions is bool && data.notifyWeeklyDigest is bool
        && data.notifySafetyAlerts is bool && validDate(data.updatedAt);
    }
    function isValidWebSettings(data) {
      return data.keys().hasAll(['theme', 'accent', 'density', 'textSize', 'highContrast',
          'reduceMotion', 'enhancedFocus', 'submissionAlerts', 'deadlineReminders',
          'trainingNotifications', 'emailNotifications', 'photo', 'certifications', 'updatedAt'])
        && data.keys().hasOnly(['theme', 'accent', 'density', 'textSize', 'highContrast',
          'reduceMotion', 'enhancedFocus', 'submissionAlerts', 'deadlineReminders',
          'trainingNotifications', 'emailNotifications', 'photo', 'banner', 'certifications', 'updatedAt'])
        && data.theme in ['light', 'dark', 'system']
        && data.accent in ['rust', 'forest', 'plum']
        && data.density in ['comfortable', 'compact']
        && data.textSize in ['normal', 'large', 'larger']
        && data.highContrast is bool && data.reduceMotion is bool && data.enhancedFocus is bool
        && data.submissionAlerts is bool && data.deadlineReminders is bool
        && data.trainingNotifications is bool && data.emailNotifications is bool
        && boundedString(data.photo, 120000)
        && (data.photo == '' || data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+=*'))
        && (!('banner' in data) || (boundedString(data.banner, 300000)
          && (data.banner == '' || data.banner.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+=*'))))
        && boundedString(data.certifications, 1200) && validDate(data.updatedAt);
    }
    function isValidDirectory(data) {
      // Optional legacy fields were published by the original web projection.
      return data.keys().hasOnly(['name', 'teamName', 'organisation', 'specialisation', 'coachingRole', 'yearsExperience',
          'rosterSize', 'notifySubmissions', 'notifyWeeklyDigest', 'notifySafetyAlerts', 'updatedAt'])
        && boundedString(data.name, 60) && boundedString(data.teamName, 48)
        && (!('organisation' in data) || boundedString(data.organisation, 48))
        && (!('notifySubmissions' in data) || data.notifySubmissions is bool)
        && (!('notifyWeeklyDigest' in data) || data.notifyWeeklyDigest is bool)
        && (!('notifySafetyAlerts' in data) || data.notifySafetyAlerts is bool)
        && (!('specialisation' in data) || validSpecialisation(data.specialisation)) && validCoachingRole(data)
        && validExperience(data.yearsExperience)
        && data.rosterSize is int && data.rosterSize >= 0 && data.rosterSize <= 10000
        && validDate(data.updatedAt);
    }
    function isValidMember(data, playerUid) {
      return data.keys().hasOnly(['playerUid', 'playerName', 'position', 'status', 'requestedAt', 'decidedAt'])
        && data.playerUid == playerUid && validUid(data.playerUid)
        && boundedString(data.playerName, 60)
        && data.position in [null, 'Setter', 'OutsideHitter', 'MiddleBlocker', 'Opposite', 'Libero']
        && data.status in ['Pending', 'Active', 'Ended']
        && validDate(data.requestedAt) && nullableDate(data.decidedAt);
    }
    function isValidAssignment(data, id) {
      return data.keys().hasOnly(['id', 'coachUid', 'playerUid', 'title', 'skill', 'level', 'summary',
          'instructions', 'targetSets', 'targetReps', 'dueAt', 'status', 'createdAt', 'libraryDrillId'])
        && data.id == id && boundedString(data.id, 128) && validUid(data.coachUid) && validUid(data.playerUid)
        && boundedString(data.title, 60) && data.title.size() > 0 && validSkill(data.skill)
        && data.level in ['Beginner', 'Intermediate', 'Advanced']
        && boundedString(data.summary, 200) && boundedString(data.instructions, 1200)
        && data.targetSets is int && data.targetSets >= 1 && data.targetSets <= 10
        && data.targetReps is int && data.targetReps >= 1 && data.targetReps <= 50
        && nullableDate(data.dueAt) && validDate(data.createdAt)
        && (data.libraryDrillId == null || boundedString(data.libraryDrillId, 128))
        && data.status in ['Pending', 'InProgress', 'Completed'];
    }
    function isValidSubmission(data, id) {
      return data.keys().hasOnly(['sessionId', 'coachUid', 'playerUid', 'submittedAt', 'reviewedAt'])
        && validUid(data.coachUid) && validUid(data.playerUid) && validUid(data.sessionId)
        && id == data.coachUid + '_' + data.sessionId
        && validDate(data.submittedAt) && nullableDate(data.reviewedAt);
    }
    function isValidNote(data, id) {
      return data.keys().hasOnly(['id', 'coachUid', 'playerUid', 'sessionId', 'text', 'createdAt', 'videoMs', 'repNumber', 'hasPhoto'])
        && data.id == id && boundedString(data.id, 128) && validUid(data.coachUid) && validUid(data.playerUid)
        && (data.sessionId == null || validUid(data.sessionId))
        && boundedString(data.text, 800) && data.text.size() > 0 && validDate(data.createdAt)
        && validNoteMoment(data)
        && (!('hasPhoto' in data) || data.hasPhoto == true);
    }
    // A moment points into the session's own recording, so it needs the session;
    // a rep number only labels that moment.
    function validNoteMoment(data) {
      return (!('videoMs' in data) || (data.videoMs is int && data.videoMs >= 0 && data.videoMs <= 3600000 && data.sessionId is string))
        && (!('repNumber' in data) || ('videoMs' in data && data.repNumber is int && data.repNumber >= 1 && data.repNumber <= 1000));
    }
    function validSharedWith(values) {
      return values is list && values.size() <= 10
        && (values.size() < 1 || validUid(values[0])) && (values.size() < 2 || validUid(values[1]))
        && (values.size() < 3 || validUid(values[2])) && (values.size() < 4 || validUid(values[3]))
        && (values.size() < 5 || validUid(values[4])) && (values.size() < 6 || validUid(values[5]))
        && (values.size() < 7 || validUid(values[6])) && (values.size() < 8 || validUid(values[7]))
        && (values.size() < 9 || validUid(values[8])) && (values.size() < 10 || validUid(values[9]));
    }
    function validStage(data) {
      return data is map && data.keys().hasOnly(['stageIndex', 'angle', 'startMs', 'endMs',
          'liveRepCount', 'validRepCount', 'bestStreak', 'estimatedFormScore'])
        && data.stageIndex is int && data.stageIndex >= 0 && data.stageIndex <= 2
        && data.angle in ['Front', 'Side', 'Rear', 'Unknown']
        && validDate(data.startMs) && validDate(data.endMs) && data.endMs >= data.startMs
        && data.liveRepCount is int && data.liveRepCount >= 0 && data.liveRepCount <= 1000
        && data.validRepCount is int && data.validRepCount >= 0 && data.validRepCount <= data.liveRepCount
        && data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= data.validRepCount
        && validScore(data.estimatedFormScore);
    }
    function validStages(values) {
      return values is list && values.size() <= 3
        && (values.size() < 1 || validStage(values[0]))
        && (values.size() < 2 || validStage(values[1]))
        && (values.size() < 3 || validStage(values[2]));
    }
    function isValidSession(data, id) {
      return data.keys().hasOnly(['id', 'ownerUid', 'skill', 'drillId', 'startedAt', 'durationMs',
          'repCount', 'formScore', 'weakestCue', 'reps', 'angleStages', 'sharedWith', 'createdAt', 'updatedAt'])
        && data.id == id && boundedString(data.id, 128) && validUid(data.ownerUid)
        && validSkill(data.skill) && boundedString(data.drillId, 128)
        && validDate(data.startedAt) && validDate(data.createdAt) && validDate(data.updatedAt)
        && data.durationMs is number && data.durationMs >= 0 && data.durationMs <= 360000
        && data.repCount is int && data.repCount >= 0 && data.repCount <= 1000
        && validScore(data.formScore) && (data.weakestCue == null || boundedString(data.weakestCue, 64))
        && data.reps is list && data.reps.size() == data.repCount && data.reps.size() <= 1000
        && (!('angleStages' in data) || validStages(data.angleStages))
        && validSharedWith(data.sharedWith);
    }

    // Paid entitlements are server-managed.
    function hasPro() {
      return signedIn() && (request.auth.uid == '4j06UlYqbrbLzujmfi8VW5yEIOq2'
        || (exists(/databases/$(database)/documents/entitlements/$(request.auth.uid))
          && get(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.status == 'active'
          && (get(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.expiresAtEpochMs == 0
            || get(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.expiresAtEpochMs > request.time.toMillis())));
    }

    match /entitlements/{uid} {
      allow read: if isUser(uid);
      allow create, update, delete: if false;
    }

    // Public purchase information only: no merchant secrets in this document.
    match /billingConfig/{product} {
      allow read: if signedIn() && product == 'pro';
      allow create, update, delete: if false;
    }

    match /billingOrders/{orderId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ---- Account home ------------------------------------------------------
    // Owner read/write. Created by the web portal at registration (role COACH)
    // and lazily by clients that need a role row to exist.
    match /users/{uid} {
      allow read: if isUser(uid);
      allow create: if isUser(uid) && isValidUser(request.resource.data);
      allow update: if isUser(uid) && isValidUser(request.resource.data) && unchanged(['createdAt']);
      allow delete: if false;
    }

    // Private administrative address never enters the coach directory or roster.
    match /profiles/{uid} {
      allow read: if isUser(uid);
      allow create: if isUser(uid) && isValidPrivateProfile(request.resource.data);
      allow update: if isUser(uid) && isValidPrivateProfile(request.resource.data);
      allow delete: if false;
    }

    // ---- The athlete's assessment and plans ---------------------------------
    // Kept apart from the profile, which is close to the limit of one request.
    function validAnswers(a) {
      return a is map && a.keys().hasOnly(['experience', 'position', 'preferred', 'goal', 'goalNote', 'days', 'minutes',
          'weakPoints', 'weakNote', 'statements', 'savedAtEpochMs', 'details'])
        && a.experience in ['New', 'Developing', 'Experienced']
        && a.goal in ['LearnBasics', 'BeConsistent', 'MakeTheTeam', 'CompeteBetter', 'StayActive']
        && a.preferred is list && a.preferred.size() <= 5 && a.weakPoints is list && a.weakPoints.size() <= 8
        && boundedString(a.goalNote, 160) && boundedString(a.weakNote, 160)
        && a.days is int && a.days >= 1 && a.days <= 7 && a.minutes in [15, 30, 45, 60, 90]
        && a.statements is map && a.statements.size() <= 20 && validDate(a.savedAtEpochMs)
        && a.get('details', {}) is map && a.get('details', {}).size() <= 20;
    }
    function validPlan(p) {
      return p is map && p.keys().hasOnly(['id', 'createdAtEpochMs', 'analysis', 'measured', 'checks', 'changes'])
        && boundedString(p.id, 64) && validDate(p.createdAtEpochMs)
        && p.analysis is map && p.analysis.keys().hasOnly(['summary', 'strengths', 'weaknesses', 'improvements', 'focus', 'practices', 'weeklyGoals'])
        && boundedString(p.analysis.summary, 420) && p.analysis.practices.size() <= 3
        && p.analysis.strengths.size() <= 3 && p.analysis.weaknesses.size() <= 3 && p.analysis.improvements.size() <= 3
        && p.measured is list && p.measured.size() <= 5 && p.checks is list && p.checks.size() <= 22
        && p.changes is list && p.changes.size() <= 6;
    }
    match /athleteAssessments/{uid} {
      allow read: if isUser(uid);
      allow create, update: if isUser(uid) && notDeleting(uid)
        && request.resource.data.keys().hasOnly(['version', 'answers', 'plan', 'updatedAt'])
        && request.resource.data.version == 1 && validAnswers(request.resource.data.answers)
        && (request.resource.data.get('plan', null) == null || validPlan(request.resource.data.plan))
        && validDate(request.resource.data.updatedAt);
      allow delete: if isUser(uid);
      match /plans/{planId} {
        allow read: if isUser(uid);
        allow create: if isUser(uid) && notDeleting(uid) && validPlan(request.resource.data) && request.resource.data.id == planId;
        allow update: if false;
        allow delete: if isUser(uid);
      }
    }

    // Device tokens for training push. Keyed by token; a signed-in account may
    // claim the token for its own UID, and only that UID may remove it.
    match /pushTokens/{tokenId} {
      allow read: if false;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'token', 'platform', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'token', 'platform', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token == tokenId
        && boundedString(tokenId, 4096)
        && request.resource.data.platform == 'android'
        && validDate(request.resource.data.updatedAt);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- Coach profile (private) and directory (public to signed-in) -------
    match /coaches/{coachUid} {
      allow read: if isUser(coachUid);
      allow create, update: if isUser(coachUid) && isValidCoach(request.resource.data);
      allow delete: if false;
      match /webSettings/{settingsId} {
        allow read: if isUser(coachUid) && settingsId == 'preferences';
        allow create, update: if isUser(coachUid) && settingsId == 'preferences'
          && isValidWebSettings(request.resource.data);
        allow delete: if false;
      }
    }

    match /profileMedia/{uid} {
      function connectedCoach() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'COACH'
          && exists(/databases/$(database)/documents/roster/$(request.auth.uid)/members/$(uid))
          && get(/databases/$(database)/documents/roster/$(request.auth.uid)/members/$(uid)).data.status in ['Pending', 'Active'];
      }
      function validImage(value, maximum) {
        return boundedString(value, maximum) && (value == '' || value.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+=*'));
      }
      allow get: if signedIn() && notDeleting(uid)
        && (request.auth.uid == uid || exists(/databases/$(database)/documents/coachDirectory/$(uid)) || connectedCoach());
      allow list: if false;
      allow create, update: if isUser(uid) && notDeleting(uid)
        && request.resource.data.keys().hasOnly(['photo', 'banner', 'updatedAt'])
        && request.resource.data.keys().hasAll(['updatedAt'])
        && ('photo' in request.resource.data || 'banner' in request.resource.data)
        && (!('photo' in request.resource.data) || validImage(request.resource.data.photo, 120000))
        && (!('banner' in request.resource.data) || validImage(request.resource.data.banner, 300000))
        && validDate(request.resource.data.updatedAt);
      allow delete: if isUser(uid);
    }

    match /coachPhotos/{coachUid} {
      allow read: if signedIn() && exists(/databases/$(database)/documents/coachDirectory/$(coachUid));
      allow create, update: if isUser(coachUid)
        && notDeleting(coachUid)
        && exists(/databases/$(database)/documents/coaches/$(coachUid))
        && request.resource.data.keys().hasAll(['photo', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['photo', 'updatedAt'])
        && boundedString(request.resource.data.photo, 120000)
        && (request.resource.data.photo == '' || request.resource.data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+=*'))
        && validDate(request.resource.data.updatedAt);
      allow delete: if isUser(coachUid);
    }

    match /coachDirectory/{coachUid} {
      allow read: if signedIn();
      allow create, update: if isUser(coachUid) && isValidDirectory(request.resource.data);
      allow delete: if isUser(coachUid);
    }

    // ---- Coach checks --------------------------------------------------------
    // A coach publishes only what their signed-in token proves: that the email is
    // confirmed, and its domain when it is a restricted school or government one.
    function institutionDomain(domain) {
      return domain.matches('([a-z0-9-]+[.])+((edu|gov)([.][a-z]{2})?|(ac|sch)[.][a-z]{2})');
    }
    function isCoach(uid) {
      return exists(/databases/$(database)/documents/coachDirectory/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role in ['COACH', 'Coach'];
    }
    match /coachTrust/{coachUid} {
      allow read: if signedIn();
      allow create, update: if isUser(coachUid) && notDeleting(coachUid) && isCoach(coachUid)
        && request.auth.token.get('email_verified', false) == true
        && request.resource.data.keys().hasAll(['institutionDomain', 'confirmedAt'])
        && request.resource.data.keys().hasOnly(['institutionDomain', 'confirmedAt'])
        && request.resource.data.confirmedAt == request.time
        && request.resource.data.institutionDomain is string
        && (request.resource.data.institutionDomain == ''
          || (institutionDomain(request.resource.data.institutionDomain)
            && request.auth.token.email.lower().split('@')[1] == request.resource.data.institutionDomain));
      allow delete: if isUser(coachUid);
    }
    // Coaches the project owner knows, set by hand in the Firebase console only.
    match /coachVerified/{coachUid} {
      allow read: if signedIn();
      allow write: if false;
    }
    // One coach saying they know another. Only a coach with an institution email may.
    match /coachVouches/{vouchId} {
      allow read: if signedIn();
      allow create: if signedIn() && isCoach(request.auth.uid)
        && request.resource.data.keys().hasAll(['coachUid', 'voucherUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['coachUid', 'voucherUid', 'createdAt'])
        && request.resource.data.voucherUid == request.auth.uid
        && validUid(request.resource.data.coachUid) && request.resource.data.coachUid != request.auth.uid
        && notDeleting(request.resource.data.coachUid)
        && vouchId == request.resource.data.coachUid + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/coachDirectory/$(request.resource.data.coachUid))
        && get(/databases/$(database)/documents/coachTrust/$(request.auth.uid)).data.institutionDomain != ''
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.voucherUid == request.auth.uid;
    }

    // ---- Places on a coach's team ------------------------------------------
    // Rules cannot count documents, so the players holding a place are listed here and
    // accepting one commits both. Free holds three; Pro has no limit. A name leaves the
    // list only when that player is no longer active, and at most five leave at once.
    match /coachSlots/{coachUid} {
      function shape() {
        return request.resource.data.keys().hasAll(['players', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['players', 'updatedAt'])
          && request.resource.data.players is list && request.resource.data.players.size() <= 500
          && validDate(request.resource.data.updatedAt);
      }
      function withinPlan() {
        return request.resource.data.players.size() <= 3 || hasPro();
      }
      function gone(removed, index) {
        return removed.size() <= index
          || getAfter(/databases/$(database)/documents/roster/$(coachUid)/members/$(removed[index])).data.status != 'Active';
      }
      function onlyDeparted(removed) {
        return removed.size() <= 5 && gone(removed, 0) && gone(removed, 1) && gone(removed, 2) && gone(removed, 3) && gone(removed, 4);
      }
      allow get: if isUser(coachUid);
      allow create: if isUser(coachUid) && notDeleting(coachUid) && shape() && withinPlan();
      allow update: if isUser(coachUid) && notDeleting(coachUid) && shape()
        && onlyDeparted(resource.data.players.removeAll(request.resource.data.players))
        && (withinPlan() || request.resource.data.players.removeAll(resource.data.players).size() == 0);
      allow delete: if false;
    }

    // ---- Roster ------------------------------------------------------------
    // Player creates their OWN pending request; the coach answers; the player
    // may only ever move their own row to Ended (leave).
    match /roster/{coachUid}/members/{playerUid} {
      allow read: if isUser(coachUid) || isUser(playerUid);
      allow create: if isUser(playerUid)
        && notDeleting(coachUid)
        && hasPro()
        && isValidMember(request.resource.data, playerUid)
        && exists(/databases/$(database)/documents/coachDirectory/$(coachUid))
        && request.resource.data.status == 'Pending' && request.resource.data.decidedAt == null;
      allow update: if isValidMember(request.resource.data, playerUid)
        && notDeleting(coachUid) && notDeleting(playerUid)
        && ((isUser(coachUid) && unchanged(['playerUid', 'playerName', 'position', 'requestedAt'])
              // Accepting a player needs a place for them, see coachSlots.
              && (request.resource.data.status != 'Active' || resource.data.status == 'Active'
                || playerUid in getAfter(/databases/$(database)/documents/coachSlots/$(coachUid)).data.players))
          || (isUser(playerUid) && resource.data.playerUid == playerUid
            && ((request.resource.data.status == 'Ended'
                && unchanged(['playerUid', 'playerName', 'position', 'requestedAt']))
              || (resource.data.status == 'Ended' && request.resource.data.status == 'Pending'
                && request.resource.data.decidedAt == null && hasPro()))));
      allow delete: if false;
    }

    // Supports Android's collectionGroup("members").whereEqualTo("playerUid", uid).
    // Writes still require the explicit roster path above; unknown paths deny writes.
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.playerUid == request.auth.uid;
    }

    // ---- Assignments -------------------------------------------------------
    // Coach writes; the assigned player reads and may move status only.
    match /assignments/{assignmentId} {
      allow read: if signedIn()
        && (resource.data.coachUid == request.auth.uid
          || resource.data.playerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.coachUid == request.auth.uid
        && isValidAssignment(request.resource.data, assignmentId)
        && notDeleting(request.resource.data.playerUid)
        && isActiveMember(request.auth.uid, request.resource.data.playerUid);
      allow update: if signedIn() && isValidAssignment(request.resource.data, assignmentId)
        && notDeleting(resource.data.playerUid) && notDeleting(resource.data.coachUid)
        && unchanged(['id', 'coachUid', 'playerUid', 'createdAt'])
        && (resource.data.coachUid == request.auth.uid
          || (resource.data.playerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
      allow delete: if signedIn() && resource.data.coachUid == request.auth.uid;
    }

    // ---- Submissions -------------------------------------------------------
    // The player must hold an Active roster row to queue (rules check it, so a
    // pending request cannot push training at a coach who has not said yes).
    function isActiveMember(coachUid, playerUid) {
      return notDeleting(coachUid) && notDeleting(playerUid)
        && get(/databases/$(database)/documents/roster/$(coachUid)/members/$(playerUid)).data.status == 'Active';
    }

    // A single question/answer per training context, never an unrestricted inbox.
    function coachingText(value, maximum) {
      return boundedString(value, maximum) && value.size() > 0
        && !value.matches('\\s*')
        && !value.lower().matches('(?s).*(https?://|www[.]|@[a-z0-9_]|[a-z0-9-]+[.][a-z]{2,}\\b|[+]?[0-9][0-9 ()-]{6,}[0-9]|instagram|snapchat|telegram|whatsapp|tiktok|discord|facebook).*');
    }
    function validQuestion(data, id) {
      return data.keys().hasAll(['id', 'coachUid', 'playerUid', 'sessionId', 'topic', 'text', 'createdAt', 'answer', 'answeredAt'])
        && data.keys().hasOnly(['id', 'coachUid', 'playerUid', 'sessionId', 'topic', 'text', 'createdAt', 'answer', 'answeredAt', 'followUp1', 'followUp2', 'resolvedAt', 'coachReadAt', 'playerReadAt'])
        && validUid(data.coachUid) && validUid(data.playerUid)
        && data.coachUid != data.playerUid
        && (data.sessionId == null || validUid(data.sessionId))
        && data.id == id && validUid(id)
        && validFollowUp(data.get('followUp1', null)) && validFollowUp(data.get('followUp2', null))
        && (data.get('followUp2', null) == null || (data.get('followUp1', null) != null && data.followUp1.answer != null))
        && coachingText(data.text, 300)
        && data.createdAt is timestamp
        && ((data.sessionId == null && data.topic in ['FirstDrill', 'TrainingFocus', 'RecordingHelp'])
          || (data.sessionId != null && data.topic in ['Technique', 'DrillInstructions', 'FeedbackClarification']))
        && ((data.answer == null && data.answeredAt == null)
          || (coachingText(data.answer, 1000) && data.answeredAt is timestamp));
    }
    function reviewedSession(coachUid, playerUid, sessionId) {
      let receipt = get(/databases/$(database)/documents/submissions/$(coachUid + '_' + sessionId)).data;
      return receipt.coachUid == coachUid && receipt.playerUid == playerUid && receipt.sessionId == sessionId
        && receipt.reviewedAt != null;
    }
    function validFollowUp(turn) {
      return turn == null || (turn is map
        && turn.keys().hasAll(['text', 'createdAt', 'answer', 'answeredAt'])
        && turn.keys().hasOnly(['text', 'createdAt', 'answer', 'answeredAt'])
        && coachingText(turn.text, 300) && turn.createdAt is timestamp
        && ((turn.answer == null && turn.answeredAt == null)
          || (coachingText(turn.answer, 1000) && turn.answeredAt is timestamp)));
    }
    function awaitingCoach(data) {
      return data.answer == null
        || (data.get('followUp1', null) != null && data.followUp1.answer == null)
        || (data.get('followUp2', null) != null && data.followUp2.answer == null);
    }
    function newFollowUp(old, data, field) {
      return data.diff(old).affectedKeys().hasOnly([field]) && old.get(field, null) == null
        && data.get(field, null) != null && validFollowUp(data[field]) && data[field].createdAt == request.time
        && data[field].answer == null && data[field].answeredAt == null;
    }
    function followUpAnswer(old, data, field) {
      return data.diff(old).affectedKeys().hasOnly([field]) && old.get(field, null) != null
        && old[field].answer == null && data[field].answer != null
        && coachingText(data[field].answer, 1000)
        && data[field].answeredAt == request.time
        && data[field].diff(old[field]).affectedKeys().hasOnly(['answer', 'answeredAt']);
    }
    function readMarker(old, data, field) {
      return data.diff(old).affectedKeys().hasOnly([field]) && data[field] is timestamp
        && data[field] <= request.time
        && (old.get(field, null) == null || data[field] >= old[field]);
    }
    match /coachingLocks/{pairId} {
      allow read: if signedIn() && (!exists(/databases/$(database)/documents/coachingLocks/$(pairId))
        || resource.data.coachUid == request.auth.uid || resource.data.playerUid == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll(['coachUid', 'playerUid', 'questionId'])
        && request.resource.data.keys().hasOnly(['coachUid', 'playerUid', 'questionId'])
        && request.resource.data.playerUid == request.auth.uid
        && pairId == request.resource.data.coachUid + '_' + request.auth.uid
        && isActiveMember(request.resource.data.coachUid, request.auth.uid)
        && (!exists(/databases/$(database)/documents/coachingLocks/$(pairId))
          || (resource.data.coachUid == request.resource.data.coachUid
            && resource.data.playerUid == request.resource.data.playerUid
            && get(/databases/$(database)/documents/coachingQuestions/$(resource.data.questionId)).data.get('resolvedAt', null) != null))
        && getAfter(/databases/$(database)/documents/coachingQuestions/$(request.resource.data.questionId)).data.coachUid == request.resource.data.coachUid
        && getAfter(/databases/$(database)/documents/coachingQuestions/$(request.resource.data.questionId)).data.playerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/coachingQuestions/$(request.resource.data.questionId)).data.createdAt == request.time;
      allow delete: if false;
    }
    match /coachingQuestions/{questionId} {
      allow read: if signedIn() && (resource.data.coachUid == request.auth.uid || resource.data.playerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.playerUid == request.auth.uid
        && validQuestion(request.resource.data, questionId)
        && isActiveMember(request.resource.data.coachUid, request.auth.uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.answer == null && request.resource.data.answeredAt == null
        && request.resource.data.get('followUp1', null) == null && request.resource.data.get('followUp2', null) == null
        && request.resource.data.get('resolvedAt', null) == null
        && request.resource.data.get('coachReadAt', null) == null && request.resource.data.get('playerReadAt', null) == null
        && getAfter(/databases/$(database)/documents/coachingLocks/$(request.resource.data.coachUid + '_' + request.auth.uid)).data.questionId == questionId
        && (request.resource.data.sessionId == null || reviewedSession(request.resource.data.coachUid, request.auth.uid, request.resource.data.sessionId));
      allow update: if signedIn()
        && notDeleting(resource.data.coachUid) && notDeleting(resource.data.playerUid)
        && ((resource.data.coachUid == request.auth.uid && readMarker(resource.data, request.resource.data, 'coachReadAt'))
          || (resource.data.playerUid == request.auth.uid && readMarker(resource.data, request.resource.data, 'playerReadAt'))
          || (isActiveMember(resource.data.coachUid, resource.data.playerUid)
            && resource.data.get('resolvedAt', null) == null
            && ((resource.data.playerUid == request.auth.uid && !awaitingCoach(resource.data)
                && (newFollowUp(resource.data, request.resource.data, 'followUp1')
                  || (resource.data.get('followUp1', null) != null && newFollowUp(resource.data, request.resource.data, 'followUp2'))))
              || (resource.data.coachUid == request.auth.uid
                && (followUpAnswer(resource.data, request.resource.data, 'followUp1')
                  || followUpAnswer(resource.data, request.resource.data, 'followUp2')
                  || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'answeredAt'])
                    && resource.data.answer == null && request.resource.data.answer != null
                    && coachingText(request.resource.data.answer, 1000)
                    && request.resource.data.answeredAt == request.time
                    && getAfter(/databases/$(database)/documents/coachResponseTimes/$(questionId)).data.coachUid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/coachResponseTimes/$(questionId)).data.askedAt == resource.data.createdAt
                    && getAfter(/databases/$(database)/documents/coachResponseTimes/$(questionId)).data.answeredAt == request.time)))
              || ((resource.data.playerUid == request.auth.uid || resource.data.coachUid == request.auth.uid)
                && !awaitingCoach(resource.data)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolvedAt'])
                && request.resource.data.resolvedAt == request.time))));
      allow delete: if false;
    }
    // Open chat between a coach and a connected player. Either side may start and send
    // any number of messages; contact details stay blocked and messages are permanent.
    match /coachingMessages/{messageId} {
      allow read: if signedIn() && (resource.data.coachUid == request.auth.uid || resource.data.playerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['id', 'coachUid', 'playerUid', 'senderUid', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'coachUid', 'playerUid', 'senderUid', 'text', 'createdAt'])
        && request.resource.data.id == messageId && validUid(messageId)
        && validUid(request.resource.data.coachUid) && validUid(request.resource.data.playerUid)
        && request.resource.data.coachUid != request.resource.data.playerUid
        && request.resource.data.senderUid == request.auth.uid
        && request.auth.uid in [request.resource.data.coachUid, request.resource.data.playerUid]
        && coachingText(request.resource.data.text, 1000)
        && request.resource.data.createdAt == request.time
        && isActiveMember(request.resource.data.coachUid, request.resource.data.playerUid);
      allow update, delete: if false;
    }
    // Each participant owns one monotonic read marker per connection.
    match /coachingReads/{pairId} {
      allow read: if signedIn() && (!exists(/databases/$(database)/documents/coachingReads/$(pairId))
        || resource.data.coachUid == request.auth.uid || resource.data.playerUid == request.auth.uid);
      allow create: if signedIn() && validChatRead(request.resource.data, pairId)
        && chatMarker({}, request.resource.data, request.resource.data.coachUid == request.auth.uid ? 'coachReadAt' : 'playerReadAt')
        && request.resource.data.get(request.resource.data.coachUid == request.auth.uid ? 'playerReadAt' : 'coachReadAt', null) == null;
      allow update: if signedIn() && validChatRead(request.resource.data, pairId)
        && unchanged(['coachUid', 'playerUid'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([resource.data.coachUid == request.auth.uid ? 'coachReadAt' : 'playerReadAt'])
        && chatMarker(resource.data, request.resource.data, resource.data.coachUid == request.auth.uid ? 'coachReadAt' : 'playerReadAt');
      allow delete: if false;
    }
    function validChatRead(data, pairId) {
      return data.keys().hasAll(['coachUid', 'playerUid'])
        && data.keys().hasOnly(['coachUid', 'playerUid', 'coachReadAt', 'playerReadAt'])
        && validUid(data.coachUid) && validUid(data.playerUid)
        && request.auth.uid in [data.coachUid, data.playerUid]
        && pairId == data.coachUid + '_' + data.playerUid
        && exists(/databases/$(database)/documents/roster/$(data.coachUid)/members/$(data.playerUid));
    }
    function chatMarker(old, data, field) {
      return data.get(field, null) is timestamp && data[field] <= request.time
        && (old.get(field, null) == null || data[field] >= old[field]);
    }
    match /coachResponseTimes/{questionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['coachUid', 'askedAt', 'answeredAt'])
        && request.resource.data.coachUid == request.auth.uid
        && request.resource.data.answeredAt == request.time
        && request.resource.data.askedAt == getAfter(/databases/$(database)/documents/coachingQuestions/$(questionId)).data.createdAt
        && getAfter(/databases/$(database)/documents/coachingQuestions/$(questionId)).data.coachUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/coachingQuestions/$(questionId)).data.answer != null
        && getAfter(/databases/$(database)/documents/coachingQuestions/$(questionId)).data.answeredAt == request.time;
      allow update, delete: if false;
    }
    match /coachAvailability/{coachUid} {
      allow read: if signedIn();
      // Retained for cleanup of legacy data; new clients ignore manual statuses.
      allow write: if false;
    }
    function validCoachPresence(data) {
      return data.keys().hasAll(['coachUid', 'status', 'updatedAt', 'expiresAt'])
        && data.keys().hasOnly(['coachUid', 'status', 'updatedAt', 'expiresAt'])
        && data.coachUid == request.auth.uid
        && exists(/databases/$(database)/documents/coachDirectory/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['COACH', 'Coach']
        && data.status in ['Online', 'Busy', 'Offline']
        && data.updatedAt is timestamp && data.updatedAt == request.time
        && data.expiresAt is timestamp && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(150, 's');
    }
    match /coachPresence/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn() && validCoachPresence(request.resource.data);
      allow update: if signedIn() && resource.data.coachUid == request.auth.uid
        && validCoachPresence(request.resource.data);
      allow delete: if signedIn() && resource.data.coachUid == request.auth.uid;
    }
    match /coachReviews/{reviewId} {
      allow read: if signedIn();
      allow get: if signedIn() && !exists(/databases/$(database)/documents/coachReviews/$(reviewId));
      allow create, update: if signedIn() && request.resource.data.playerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['id', 'coachUid', 'playerUid', 'sessionId', 'rating', 'text', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['id', 'coachUid', 'playerUid', 'sessionId', 'rating', 'text', 'createdAt', 'updatedAt'])
        && validUid(request.resource.data.coachUid) && validUid(request.resource.data.sessionId)
        && request.resource.data.id == reviewId
        && reviewId == request.resource.data.coachUid + '_' + request.auth.uid + '_' + request.resource.data.sessionId
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && boundedString(request.resource.data.text, 500)
        && reviewedSession(request.resource.data.coachUid, request.auth.uid, request.resource.data.sessionId)
        && request.resource.data.updatedAt == request.time
        && ((!exists(/databases/$(database)/documents/coachReviews/$(reviewId))
              && isActiveMember(request.resource.data.coachUid, request.auth.uid) && request.resource.data.createdAt == request.time)
          || (exists(/databases/$(database)/documents/coachReviews/$(reviewId))
              && unchanged(['id', 'coachUid', 'playerUid', 'sessionId', 'createdAt'])));
      allow delete: if false;
    }

    // ---- Coach marks on reps ---------------------------------------------------
    // A connected coach's Right or Wrong on one rep. The player's own app reads it and
    // lets it outrank the camera. Nobody else can read it. Only the website checks that
    // the coach is verified, because reviews and vouches cannot be counted here. Pro only.
    function validRepLabel(data, labelId) {
      let session = get(/databases/$(database)/documents/sessions/$(data.sessionId)).data;
      return data.keys().hasAll(['sessionId', 'playerUid', 'coachUid', 'skill', 'repNumber', 'verdict', 'cueIds', 'createdAt'])
        && data.keys().hasOnly(['sessionId', 'playerUid', 'coachUid', 'skill', 'repNumber', 'verdict', 'cueIds', 'createdAt'])
        && data.createdAt == request.time && data.playerUid != data.coachUid
        && session.ownerUid == data.playerUid && data.coachUid in session.sharedWith && session.skill == data.skill
        && data.repNumber is int && data.repNumber >= 1 && data.repNumber <= session.repCount
        && labelId == data.sessionId + '_' + string(data.repNumber) + '_' + data.coachUid
        && data.cueIds is list && data.cueIds.size() <= 6
        && (data.verdict == 'Wrong' || (data.verdict == 'Right' && data.cueIds.size() == 0))
        && data.cueIds.hasOnly(['ServeContactArmExtension', 'ServeReachHeight', 'ServeTrunkLean', 'ServeTossArmLift', 'PassPlatformStraight',
          'PassPlatformHeight', 'PassKneeFlexion', 'PassTrunkAngle', 'PassShouldersLevel', 'SetHandsAboveForehead',
          'SetElbowFlexion', 'SetKneeFlexion', 'SetExtensionFollowThrough', 'SpikeApproachLoad', 'SpikeArmExtension',
          'SpikeElbowHeight', 'SpikeTrunkDrive', 'BlockArmExtension', 'BlockHandSeparation', 'BlockPenetration',
          'BlockKneeLoad']);
    }
    match /repLabels/{labelId} {
      allow read: if signedIn()
        && (resource.data.coachUid == request.auth.uid || resource.data.playerUid == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.coachUid == request.auth.uid
        && hasPro()
        && isActiveMember(request.auth.uid, request.resource.data.playerUid)
        && validRepLabel(request.resource.data, labelId);
      allow delete: if signedIn()
        && (resource.data.coachUid == request.auth.uid || resource.data.playerUid == request.auth.uid);
    }

    match /submissions/{submissionId} {
      // Transactions must be able to check for a receipt before creating it.
      // This grants no access to existing submissions or collection lists.
      allow get: if signedIn() && !exists(/databases/$(database)/documents/submissions/$(submissionId));
      allow read: if signedIn()
        && (resource.data.coachUid == request.auth.uid
          || resource.data.playerUid == request.auth.uid);
      allow create: if signedIn()
        && isValidSubmission(request.resource.data, submissionId)
        && request.resource.data.playerUid == request.auth.uid
        && request.resource.data.reviewedAt == null
        && isActiveMember(request.resource.data.coachUid, request.auth.uid)
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.ownerUid == request.auth.uid;
      // Player re-queues (clears reviewedAt); coach stamps reviewedAt.
      allow update: if signedIn() && isValidSubmission(request.resource.data, submissionId)
        && notDeleting(resource.data.playerUid) && notDeleting(resource.data.coachUid)
        && unchanged(['sessionId', 'coachUid', 'playerUid'])
        && ((resource.data.playerUid == request.auth.uid
            && request.resource.data.reviewedAt == null
            && isActiveMember(resource.data.coachUid, request.auth.uid))
          || (resource.data.coachUid == request.auth.uid && unchanged(['submittedAt'])));
      allow delete: if false;
    }

    // ---- Notes -------------------------------------------------------------
    match /notes/{noteId} {
      allow read: if signedIn()
        && (resource.data.coachUid == request.auth.uid
          || resource.data.playerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.coachUid == request.auth.uid
        && isValidNote(request.resource.data, noteId)
        && notDeleting(request.resource.data.playerUid)
        && exists(/databases/$(database)/documents/roster/$(request.auth.uid)/members/$(request.resource.data.playerUid))
        // A note that says it has a photo commits together with that photo.
        && (!('hasPhoto' in request.resource.data) || existsAfter(/databases/$(database)/documents/noteMedia/$(noteId)));
      allow update, delete: if false;
    }

    // ---- Feedback photos ---------------------------------------------------
    // One JPEG per note, kept apart so note lists stay small. Only the note's
    // coach and player can open it. It is created in the same commit as its note
    // and never replaced; the coach may remove it, leaving the written feedback.
    match /noteMedia/{noteId} {
      function noteAfter() {
        return getAfter(/databases/$(database)/documents/notes/$(noteId)).data;
      }
      allow get: if signedIn() && (resource == null
        || resource.data.coachUid == request.auth.uid
        || resource.data.playerUid == request.auth.uid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['coachUid', 'playerUid', 'photo', 'createdAt'])
        && request.resource.data.keys().hasOnly(['coachUid', 'playerUid', 'photo', 'createdAt'])
        && request.resource.data.coachUid == request.auth.uid
        && validUid(request.resource.data.playerUid) && validDate(request.resource.data.createdAt)
        && boundedString(request.resource.data.photo, 300000)
        && request.resource.data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+=*')
        && !exists(/databases/$(database)/documents/notes/$(noteId))
        && existsAfter(/databases/$(database)/documents/notes/$(noteId))
        && noteAfter().coachUid == request.auth.uid
        && noteAfter().playerUid == request.resource.data.playerUid
        && noteAfter().hasPhoto == true
        && hasPro()
        && isActiveMember(request.auth.uid, request.resource.data.playerUid);
      allow update: if false;
      allow delete: if signedIn() && resource.data.coachUid == request.auth.uid;
    }

    match /accountDeletions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Authorization-only probe for the external AI service. No document is
    // stored here: an authorized GET returns not-found, while Firestore still
    // verifies the caller's token and applies the stricter AI sharing policy.
    // Historical session reads below deliberately retain their existing rules.
    match /aiSessionAccess/{sessionId} {
      function canExplainSession() {
        let session = get(/databases/$(database)/documents/sessions/$(sessionId)).data;
        return session.ownerUid is string && notDeleting(session.ownerUid)
          && (session.ownerUid == request.auth.uid
            || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'COACH'
              && request.auth.uid in session.sharedWith
              && isActiveMember(request.auth.uid, session.ownerUid)));
      }
      allow get: if signedIn()
        && exists(/databases/$(database)/documents/sessions/$(sessionId))
        && canExplainSession();
      allow list, create, update, delete: if false;
    }

    match /recordings/{sessionId} {
      function sessionData() { return get(/databases/$(database)/documents/sessions/$(sessionId)).data; }
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/recordings/$(sessionId))
        || sessionData().ownerUid == request.auth.uid || request.auth.uid in sessionData().sharedWith);
      allow create, update: if signedIn() && sessionData().ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'sessionId', 'version', 'videoBytes', 'reviewBytes', 'ready'])
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.sessionId == sessionId
        && request.resource.data.version == 1 && request.resource.data.ready == true
        && request.resource.data.videoBytes is int && request.resource.data.videoBytes > 0 && request.resource.data.videoBytes <= 104857600
        && request.resource.data.reviewBytes is int && request.resource.data.reviewBytes > 0 && request.resource.data.reviewBytes <= 10485760;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ---- Sessions ----------------------------------------------------------
    // Owner full access; a coach reads only what was shared with them.
    // `sharedWith` is append-only from the player's side — submit adds, and
    // nothing (including leave) silently un-shares history in v1.
    match /sessions/{sessionId} {
      // A saved local recording may not have reached its cloud mirror yet.
      allow get: if signedIn() && !exists(/databases/$(database)/documents/sessions/$(sessionId));
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
          || request.auth.uid in resource.data.sharedWith);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid && isValidSession(request.resource.data, sessionId);
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && isValidSession(request.resource.data, sessionId) && unchanged(['id', 'ownerUid', 'createdAt'])
        && request.resource.data.sharedWith.hasAll(resource.data.sharedWith);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
